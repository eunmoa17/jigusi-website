# Supabase 설정
# Supabase 프로젝트 Settings > API에서 확인
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 주의: 아래 키들은 .env 파일에 절대 작성하지 마세요
# 브라우저에 노출되면 안 됩니다
# 이 키들은 Supabase Dashboard > Edge Functions > Settings > Secrets에서 설정하세요
# - OPENAI_API_KEY
# - RESEND_API_KEY
# - SUPABASE_SERVICE_ROLE_KEY (Edge Function 내부용)
